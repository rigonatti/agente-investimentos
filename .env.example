ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
PORT=3000

# Sessão de login — gere um valor aleatório único, ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Usuários autorizados (separados por vírgula, minúsculos)
AUTH_USERS=rigonatti,taniamielcke

# Hash bcrypt da senha compartilhada — gere com:
# node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_AQUI', 10))"
AUTH_PASSWORD_HASH=$2a$10$exemplo-gere-o-seu-hash-com-o-comando-acima

# Usuários com acesso ao painel de administração (editar o prompt do sistema)
ADMIN_USERS=rigonatti
